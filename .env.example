# Environment Variables
# Copy to .env: cp .env.example .env
# Then fill in your values (see README for where to get each key)

# ── Supabase (local or cloud) ──────────────────────────────────
# Local: run `docker compose up -d`, then use defaults below
# Cloud: paste from Supabase Dashboard → Settings → API
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<your-local-anon-key-from-supabase-start>
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-key-from-supabase-start>

# ── Expo client-side (EXPO_PUBLIC_ prefix) ─────────────────────
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<same-as-supabase-anon-key>
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# ── PlantNet API (server-side only) ────────────────────────────
# Get key: https://my.plantnet.org/settings/api-key
PLANTNET_API_KEY=

# ── Dev mode ───────────────────────────────────────────────────
DEBUG=true
