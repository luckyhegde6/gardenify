# Environment Variables
# Copy this file to .env and fill in the values

# Supabase (from Supabase Dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL (from Vercel deployment)
EXPO_PUBLIC_API_URL=http://localhost:8000

# PlantNet API (from https://my.plantnet.org/settings/api-key)
# NOTE: This is used server-side only, never exposed to the client
PLANTNET_API_KEY=your-plantnet-api-key-here

# Supabase Server-Side (for Python backend)
# NOTE: Use service_role key for server-side operations only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
