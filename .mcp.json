{
  "mcpServers": {
    "expo": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-expo@latest"],
      "env": {
        "EXPO_TOKEN": "${EXPO_TOKEN}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-supabase@latest"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
