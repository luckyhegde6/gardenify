# ── Supabase Local Stack — Copy to .env.local and fill in values ──
# cp .env.local.example .env.local
#
# After starting: docker compose exec db psql -U postgres -c "select value from auth.config;"
# Or visit http://localhost:54323 → Settings → API

SUPABASE_ANON_KEY=<get-from-local-supabase-studio>
SUPABASE_SERVICE_ROLE_KEY=<get-from-local-supabase-studio>
JWT_SECRET=<generate-a-random-32-char-string>
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=postgres
PG_META_DB_PASSWORD=<same-as-postgres-password>
