{
  "$schema": "https://opencode.ai/config.schema.json",
  "rules": [
    "AGENTS.md",
    "CLAUDE.md",
    "MEMORY.md"
  ],
  "mcp": {
    "servers": {
      "expo": {
        "type": "streamable-http",
        "url": "https://mcp.expo.dev/mcp",
        "authorization": {
          "type": "oauth"
        }
      },
      "supabase": {
        "command": "npx",
        "args": ["-y", "@supabase/mcp-utils@latest"],
        "env": {
          "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
        }
      },
      "playwright": {
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest"]
      }
    }
  }
}
